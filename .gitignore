# Gradle
.gradle/
# Note: `build/` not `/build` — the root-only form would commit every module's build output.
build/
!gradle/wrapper/gradle-wrapper.jar

# Local SDK paths and machine-specific config
local.properties

# Signing material — Phase 10. Never commit these.
*.jks
*.keystore
keystore.properties
signing.properties

# Crash / profiling dumps. A Gradle OOM during the Phase 1.1 toolchain upgrade dropped a 574 MB
# `java_pid*.hprof` here and it got committed — the blob was later purged from history.
*.hprof

# IDE
*.iml
.idea/
!.idea/codeStyles/
.externalNativeBuild
.cxx
/captures

# OS
.DS_Store
